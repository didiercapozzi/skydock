{
  "name": "@workspace/web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "build:journey": "react-router build && tsx ../scripts/build-server.ts",
    "dev": "react-router dev --host",
    "i18n:extract": "lingui extract --clean",
    "predev": "npx --yes kill-port 5173 || true",
    "start": "react-router-serve ./build/server/index.js",
    "test": "npm run test:node && npm run test:browser && npm run test:journey",
    "test:browser": "vitest --config=vitest.browser.config.ts",
    "test:e2e": "npm run test:browser",
    "test:journey": "npm run build:journey && vitest run --config=vitest.journey.config.ts tests/journey/journey.test.ts && vitest run --config=vitest.journey.config.ts --exclude tests/journey/journey.test.ts",
    "test:journey:window": "vitest run --config=vitest.window.config.ts",
    "test:node": "vitest --config=vitest.node.config.ts",
    "test:server": "npm run test:node",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@lingui/core": "^6.8.0",
    "@lingui/react": "^6.8.0",
    "@react-router/node": "^8",
    "@react-router/serve": "^8",
    "@skydock/scripts": "file:../packages/skydock-scripts",
    "archiver": "^8.0.0",
    "isbot": "^5.1.36",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8",
    "vite-plugin-babel": "^1.7.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.29.7",
    "@lingui/babel-plugin-lingui-macro": "^6.8.0",
    "@lingui/cli": "^6.8.0",
    "@lingui/vite-plugin": "^6.8.0",
    "@react-router/dev": "^8",
    "@tailwindcss/vite": "^4.3.3",
    "@types/archiver": "^8.0.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest-browser-react": "^2.3.0"
  }
}
