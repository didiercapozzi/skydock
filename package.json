{
  "name": "@workspace",
  "private": true,
  "workspaces": [
    "web",
    "desktop"
  ],
  "type": "module",
  "scripts": {
    "check": "npm run typecheck && npm run format:check && npm run lint",
    "fc": "npm run format && npm run check",
    "format": "oxfmt --config oxfmt.config.ts .",
    "format:check": "oxfmt --config oxfmt.config.ts --check .",
    "lint": "oxlint --config oxlint.config.ts .",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "opencode-ai": "^1.18.23",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true
  }
}
