{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Read",
      "Bash(*)"
    ],
    "ask": [
      "Bash(rm -rf *)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git checkout*)",
      "Bash(git reset*)",
      "Bash(git restore*)",
      "Bash(gh *)",
      "Bash(npm install*)",
      "Bash(npm publish*)",
      "Bash(apt *)",
      "Bash(apt-get *)",
      "Bash(docker *)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf /workspace)",
      "Bash(rm -rf /workspace/*)",
      "Bash(rm -rf /mnt/osmo*)",
      "Bash(git push --force*)",
      "Bash(cat /workspace/.env*)",
      "Bash(cat .env*)",
      "Bash(grep * /workspace/.env*)",
      "Read(/workspace/.env)"
    ]
  }
}
