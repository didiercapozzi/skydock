FROM ubuntu:26.04

ARG DEBIAN_FRONTEND=noninteractive 

# Install basic packages
RUN apt update && apt install -y --no-install-recommends \
    software-properties-common \
    openssh-server \
    ca-certificates \
    wget \
    curl \
    ffmpeg \
    libimage-exiftool-perl \
    git \
    jq \
    xdg-utils \
    xz-utils \
    binutils \
    locales \
    vainfo \
    intel-gpu-tools \
    && rm -rf /var/lib/apt/lists/*

RUN apt update && apt install -y --no-install-recommends \
    intel-media-va-driver \
    libmfx-gen1.2 \
    libvpl2 \
    libva-drm2 \
    libva-x11-2 \
    && rm -rf /var/lib/apt/lists/*

    
RUN sed -i 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen && locale-gen en_US.UTF-8
    
RUN apt update && apt install -y --no-install-recommends \
    libnspr4 \
    libnss3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libgtk-3-0 \
    libatspi2.0-0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2t64 \
    libwayland-client0 \
    && rm -rf /var/lib/apt/lists/*
    
# What building the installable app needs: the window's engine and what it links against, and the
# Rust toolchain the shell is written in. Only for building it — the app itself carries its own.
RUN apt update && apt install -y --no-install-recommends \
    build-essential \
    pkg-config \
    file \
    libwebkit2gtk-4.1-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    libxdo-dev \
    libssl-dev \
    patchelf \
    && rm -rf /var/lib/apt/lists/*

# A display of the container's own, and a way to watch it from the host: the app's window is drawn
# here and served over VNC, rather than on the host's session — where a window from this privileged
# container, holding every DRM card the machine has, has taken that session down.
RUN apt update && apt install -y --no-install-recommends \
    xvfb \
    x11vnc \
    novnc \
    websockify \
    openbox \
    && rm -rf /var/lib/apt/lists/*

ENV CARGO_HOME=/usr/local/cargo \
    RUSTUP_HOME=/usr/local/rustup \
    PATH=/usr/local/cargo/bin:$PATH

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
    sh -s -- -y --default-toolchain stable --profile minimal --no-modify-path && \
    chmod -R a+rX /usr/local/cargo /usr/local/rustup

    # Install NodeJS
RUN curl -fsSL https://deb.nodesource.com/setup_26.x | bash - && \
    apt install -y --no-install-recommends \
    nodejs=26.7.0-1nodesource1 \
    && rm -rf /var/lib/apt/lists/*
    
RUN npx playwright install --with-deps firefox chromium && \
        rm -rf /var/lib/apt/lists/*