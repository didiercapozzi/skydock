FROM ubuntu:26.04

ARG DEBIAN_FRONTEND=noninteractive 

# Install basic packages
RUN apt update && apt install -y --no-install-recommends \
    software-properties-common \
    openssh-server \
    ca-certificates \
    wget \
    curl \
    ffmpeg \
    libimage-exiftool-perl \
    git \
    jq \
    xdg-utils \
    xz-utils \
    binutils \
    locales \
    vainfo \
    intel-gpu-tools \
    && rm -rf /var/lib/apt/lists/*

RUN apt update && apt install -y --no-install-recommends \
    intel-media-va-driver \
    libmfx-gen1.2 \
    libvpl2 \
    libva-drm2 \
    libva-x11-2 \
    && rm -rf /var/lib/apt/lists/*

    
RUN sed -i 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen && locale-gen en_US.UTF-8
    
# What a window needs, which is what Chromium needs: the app's own is drawn by the same engine as
# the browser the tests run in, so there is one set of these and not two.
RUN apt update && apt install -y --no-install-recommends \
    libnspr4 \
    libnss3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libgtk-3-0 \
    libatspi2.0-0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2t64 \
    libwayland-client0 \
    && rm -rf /var/lib/apt/lists/*
    
# A display of the container's own, and a way to watch it from the host: the app's window is drawn
# here and served over VNC, rather than on the host's session — where a window from this privileged
# container, holding every DRM card the machine has, has taken that session down.
RUN apt update && apt install -y --no-install-recommends \
    xvfb \
    x11vnc \
    novnc \
    websockify \
    openbox \
    && rm -rf /var/lib/apt/lists/*

# What the journey tests of the window need: a real pointer on that display (xdotool), and GTK for the small
# program that offers files to be dropped, the way a file manager does.
RUN apt update && apt install -y --no-install-recommends \
    xdotool \
    gir1.2-gtk-3.0 \
    && rm -rf /var/lib/apt/lists/*

    # Install NodeJS
RUN curl -fsSL https://deb.nodesource.com/setup_26.x | bash - && \
    apt install -y --no-install-recommends \
    nodejs=26.7.0-1nodesource1 \
    && rm -rf /var/lib/apt/lists/*
    
RUN npx playwright install --with-deps firefox chromium && \
        rm -rf /var/lib/apt/lists/*

# The GitHub CLI, for starting a build of the installers without tagging a release and reading what
# it came to. From its own repository, the way the project documents it for Debian: the key it signs
# with, a source that trusts that key, and then the program.
# https://github.com/cli/cli/blob/trunk/docs/install_linux.md#debian-ubuntu-linux-raspberry-pi-os-apt
RUN mkdir -p -m 755 /etc/apt/keyrings && \
    out=$(mktemp) && wget -nv -O"$out" https://cli.github.com/packages/githubcli-archive-keyring.gpg && \
    cat "$out" > /etc/apt/keyrings/githubcli-archive-keyring.gpg && \
    chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg && \
    mkdir -p -m 755 /etc/apt/sources.list.d && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list && \
    apt update && \
    apt install -y --no-install-recommends gh && \
    rm -rf /var/lib/apt/lists/*