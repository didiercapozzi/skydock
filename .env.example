# Host username
HOST_USER=dcapozzi

# Filesystem Volume Labels for the SD cards
CAM_PHOTO_LABEL=NANO_PHOTO
CAM_VIDEO_LABEL=NANO_VIDEO

# Destination directory on host
HOST_OUTPUT_DIR=/home/dcapozzi/Desktop/tandem_jumps

# Jump splitting threshold (15 minutes = 900 seconds)
JUMP_GAP_SECONDS=900

# Extraction settings for Camera 1 (2 fps = 1 frame every 0.5s)
PHOTO_FPS=2
JPEG_QUALITY=2

# Host Timezone
TZ=Europe/Zurich
