{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SkyDock",
  "version": "0.1.0",
  "identifier": "ch.skydock.app",
  "build": {
    "beforeBuildCommand": "node scripts/build-sidecar.mjs",
    "frontendDist": "../web/build/client"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "A dropzone's media, from the cameras to the passenger",
    "longDescription": "SkyDock copies a dropzone's cameras, sorts what it finds into jumps, prepares the files, cuts a montage and sends each passenger their film.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/skydock-node", "binaries/skydock-ffmpeg", "binaries/skydock-ffprobe"],
    "resources": ["resources/**/*"],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
